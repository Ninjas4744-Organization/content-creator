{
	"name": "davinci-library-cloudflare",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"prepare:content": "../../../.venv/bin/python ../../../scripts/prepare_cloudflare.py",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"dev": "wrangler dev",
		"check:deploy": "npm run prepare:content && wrangler deploy --dry-run --outdir ../output/cloudflare-bundle",
		"deploy": "npm run prepare:content && wrangler deploy",
		"format": "prettier --write src tests *.json *.jsonc *.ts",
		"format:check": "prettier --check src tests *.json *.jsonc *.ts"
	},
	"dependencies": {
		"fast-xml-parser": "5.11.2",
		"jose": "6.2.13"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.7",
		"@cloudflare/workers-types": "5.20261026.1",
		"@types/node": "26.6.5",
		"prettier": "3.9.10",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"wrangler": "4.152.0"
	}
}
