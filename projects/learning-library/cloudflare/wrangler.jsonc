{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "davinci-learning-library",
	"account_id": "a7ae291ec1fdbfb9cf661940e399d9d1",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-26",
	"workers_dev": false,
	"keep_vars": true,
	"routes": [
		{
			"pattern": "knowledge.davinci4744.com",
			"custom_domain": true,
		},
	],
	"assets": {
		"directory": "../output/cloudflare-assets",
		"binding": "ASSETS",
		"run_worker_first": ["/lti", "/lti/*", "/health", "/library/media/*.mp4"],
		"html_handling": "auto-trailing-slash",
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
	},
}
