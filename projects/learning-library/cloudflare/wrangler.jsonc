{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "davinci-learning-library",
	"account_id": "a7ae291ec1fdbfb9cf661940e399d9d1",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-26",
	"workers_dev": false,
	"keep_vars": true,
	"routes": [
		{
			"pattern": "knowledge.davinci4744.com",
			"custom_domain": true,
		},
	],
	"assets": {
		"directory": "../output/cloudflare-assets",
		"binding": "ASSETS",
		"run_worker_first": ["/lti/*", "/health", "/library/media/*.mp4"],
		"html_handling": "auto-trailing-slash",
	},
	"vars": {
		"TOOL_URL": "https://knowledge.davinci4744.com",
		"CLIENT_ID": "davinci-learning-library",
		"DEPLOYMENT_ID": "na",
		"KEY_ID": "davinci-lti-1",
		"PASS_SCORE": "0.8",
		"SESSION_SECONDS": "28800",
		"RETENTION_DAYS": "90",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "davinci-library-lti",
			"database_id": "0b93643c-fd00-413d-b3f2-c28afb41b19f",
			"migrations_dir": "migrations",
		},
	],
	"triggers": {
		"crons": ["17 * * * *"],
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
	},
}
