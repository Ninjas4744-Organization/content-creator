{
	"name": "davinci-learning-library",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"prepare:content": "node ../../scripts/prepare-gallery.mjs",
		"prestart": "npm run prepare:content",
		"start": "expo start --web",
		"build": "npm run prepare:content && expo export --platform web --output-dir output/site",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test tests/*.test.ts",
		"format": "prettier --write app src tests *.json *.js *.ts",
		"format:check": "prettier --check app src tests *.json *.js *.ts"
	},
	"dependencies": {
		"@expo/metro-runtime": "~56.0.18",
		"expo": "~56.0.24",
		"expo-constants": "~56.0.22",
		"expo-font": "~56.0.7",
		"expo-linking": "~56.0.16",
		"expo-router": "~56.2.17",
		"mobx": "^6.15.0",
		"mobx-react-lite": "^4.1.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.85.3",
		"react-native-reanimated": "4.3.1",
		"react-native-worklets": "0.8.3",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-web": "~0.21.0",
		"styled-components": "^6.1.19"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "~19.2.10",
		"prettier": "^3.6.2",
		"tsx": "^4.20.0",
		"typescript": "~5.9.2"
	},
	"engines": {
		"node": ">=22.13.0"
	}
}
